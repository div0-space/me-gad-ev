# deploy/caddy-gate.snippet — OAuth course enrollment gate for S01 entries.
# PROPOSAL ONLY. Nothing in this repo applies it; the operator pastes it (see below).
#
# What it does
#   /members/* own detailed records ask the gate app (127.0.0.1:8000,
#   GET /gate/check) before files are served from /srv/megadev-gated.
#   Verbatim course entries return 410; private originals are not deleted.
#   A valid `megadev_gate` cookie => 200 => the entry is served. Anything else =>
#   redirect to /gate/?next=<path>. Teaser pages /challenge/s01e0X/, the index
#   /challenge/ and all other static files are untouched and public.
#
# Operator steps
#   1. Put the gate app's env in its unit/env file (never in the repo):
#        GATE_SECRET=<openssl rand -hex 32>       # >= 16 chars, else the gate answers 503
#        GATE_OAUTH_CLIENT_ID=<registered-production-client-id>
#        GATE_OAUTH_REDIRECT_URI=https://megadev.div0.space/gate/callback
#      Register the production callback separately; the local preview client is not deployable here.
#      Behind HTTPS leave GATE_COOKIE_SECURE at its default (on).
#   2. Integrate the blocks below INSIDE the `megadev.div0.space { ... }` site block,
#      the existing static `root`/`file_server` and the Bearer-gated `/mcp*` and `/api/*`.
#      The /gate/* endpoints must NOT sit behind the Bearer gate: visitors have no token.
#      Adjust `root` in block 2 if the landing root differs from /srv/megadev-landing.
#      Replace this domain's access-log output with `discard`; do not alter other domains.
#      Keep the backend's --no-access-log. Remove historical domain access logs only
#      with the owner's approval. Infrastructure error logs are a separate concern.
#   3. `caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy`
#   4. Check:
#        curl -si https://megadev.div0.space/challenge/s01e01/entry/ # 410, even with a cookie
#        curl -s  https://megadev.div0.space/gate/handshake                  # OAuth instructions
#        curl -si https://megadev.div0.space/challenge/                       # 200, still public
#
# The gated entries live only under /srv/megadev-gated on the host — they are not in
# the public repo. See server/README.md, "Course enrollment gate".

# Private team MCP/API — REPLACE the existing Bearer handlers, do not duplicate them.
# MEGADEV_MCP_TOKEN belongs in Caddy's private environment, never this repository.
# The running installation may retain its existing private token configuration.
# This static Bearer gate is NOT the official course OAuth enrollment gate.
handle /mcp* {
	@noauth not header Authorization "Bearer {$MEGADEV_MCP_TOKEN}"
	handle @noauth {
		header {
			Content-Type application/json
			Cache-Control no-store
			WWW-Authenticate `Bearer realm="private-mcp"`
		}
		respond `{"error":"private_mcp","private":true,"message":"Private team MCP. Configure Authorization: Bearer <token> using the token supplied privately by the owner. OAuth sign-in is not supported here.","authentication":{"type":"bearer","header":"Authorization","scheme":"Bearer","oauth":false}}` 401
	}
	reverse_proxy 127.0.0.1:8000
}
handle /api/* {
	@noauth_api not header Authorization "Bearer {$MEGADEV_MCP_TOKEN}"
	handle @noauth_api {
		header {
			Content-Type application/json
			Cache-Control no-store
			WWW-Authenticate `Bearer realm="private-mcp"`
		}
		respond `{"error":"private_mcp","private":true,"message":"Private team MCP. Configure Authorization: Bearer <token> using the token supplied privately by the owner. OAuth sign-in is not supported here.","authentication":{"type":"bearer","header":"Authorization","scheme":"Bearer","oauth":false}}` 401
	}
	reverse_proxy 127.0.0.1:8000
}

# Replace the domain's existing log block, not an additional logger.
log {
	output discard
}

# Do not redistribute the old verbatim instructions, even to enrolled visitors.
@retired_course_entry path /challenge/s01e01/entry /challenge/s01e01/entry/* /challenge/s01e02/entry /challenge/s01e02/entry/* /challenge/s01e03/entry /challenge/s01e03/entry/*
handle @retired_course_entry {
	header Cache-Control no-store
	header X-Robots-Tag "noindex, nofollow"
	respond "This verbatim course entry is no longer distributed. Read our own account in the member journal or visit the official course." 410
}

# Block 1 — the gate's own endpoints, public, proxied to the app.
@gate_api path /gate/handshake /gate/login /gate/callback /gate/check
handle @gate_api {
	reverse_proxy 127.0.0.1:8000
}

# Member records fail closed; never move this root into the public tree.
@gated path /members /members/*
handle @gated {
	forward_auth 127.0.0.1:8000 {
		uri /gate/check
		# Any non-2xx from the gate (401 closed, 503 unconfigured) sends the visitor to the gate page.
		@denied status 4xx 5xx
		handle_response @denied {
			redir * /gate/?next={http.request.orig_uri.path} 302
		}
	}
	root * /srv/megadev-gated
	file_server
}

# Replace the existing public fallback. Mutable documents must not retain the old language.
handle {
	@public_document not path /assets/*
	header @public_document Cache-Control no-store
	root * /srv/megadev-landing
	file_server
}
